{
  "component": "quickshell",
  "release": "@CLAVIS_RELEASE@",
  "commit": "@CLAVIS_COMMIT@",
  "buildTime": "@CLAVIS_BUILD_TIME@",
  "channel": "@CLAVIS_CHANNEL@",
  "sourceDirty": @CLAVIS_SOURCE_DIRTY@,
  "sourceFingerprint": "@CLAVIS_SOURCE_FINGERPRINT@",
  "minimumKeyCli": "0.1.0",
  "minimumKeytop": "0.1.0",
  "shellProtocol": 1,
  "paths": {
    "qml": "share/clavis/qml",
    "plugins": "lib/qml",
    "assets": "share/clavis/assets"
  },
  "protocols": {
    "core": 1,
    "clipboard": 2
  },
  "dataSchemas": {
    "config": 1,
    "manifest": 1,
    "profile": 1
  },
  "dependencyManifest": 2
}
